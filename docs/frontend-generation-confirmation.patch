+import { HttpClient, HttpErrorResponse, HttpResponse } from '@angular/common/http';
+import { Injectable } from '@angular/core';
+import { Observable, retry, throwError, timer } from 'rxjs';
+
+@Injectable({
+  providedIn: 'root',
+})
+export class FormularioService {
+  // private readonly API_URL =
+  //   'https://ipdebackendcertificados-production.up.railway.app/api/diplomas';
+  // private readonly API_URL = 'http://localhost:8001/api/diplomas';
+  // private readonly API_URL = 'https://legwork-sulfide-slacking.ngrok-free.dev/api/diplomas';
+  private readonly API_URL = 'https://diplomas-back.onrender.com/api/diplomas';
+
+  constructor(private http: HttpClient) {}
+
+  /** Envía múltiples modelos y recibe el PPTX con headers incluidos */
+  generarPPTX(payload: any): Observable<HttpResponse<Blob>> {
+    return this.http.post(this.API_URL, payload, {
+      responseType: 'blob',
+      observe: 'response',
+    });
+  }
+  /** Confirma la recepción del archivo sin volver a generar el PPTX. */
+  confirmarGeneracion(
+    generationId: string,
+  ): Observable<{ ok: boolean; generation_id: string }> {
+    return this.http.post<{ ok: boolean; generation_id: string }>(
+      `${this.API_URL}/confirmar/${encodeURIComponent(generationId)}`,
+      {},
+      { timeout: 10000 },
+    ).pipe(
+      retry({
+        count: 2,
+        delay: (error: unknown, intento: number) => {
+          const temporal =
+            error instanceof HttpErrorResponse &&
+            (error.status === 0 ||
+              error.status === 408 ||
+              error.status === 429 ||
+              (error.status >= 500 && error.status < 600));
+
+          return temporal ? timer(intento * 1000) : throwError(() => error);
+        },
+      }),
+    );
+  }
+}
