+import { HttpClient, HttpHeaders, HttpResponse } from '@angular/common/http';
+import { Renderer2 } from '@angular/core';
+import { FormBuilder } from '@angular/forms';
+import { Observable, Subject, of, throwError } from 'rxjs';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { FormularioService } from '../../services/formularioService';
+import { Formulario } from './formulario';
+
+describe('Formulario: confirmación de descarga', () => {
+  const generationId = '0123456789abcdef0123456789abcdef';
+  let response: Subject<HttpResponse<Blob>>;
+  let component: Formulario;
+  let service: {
+    generarPPTX: ReturnType<typeof vi.fn>;
+    confirmarGeneracion: ReturnType<typeof vi.fn>;
+  };
+  let download: ReturnType<typeof vi.fn<(blob: Blob, filename: string) => void>>;
+  let steps: string[];
+
+  beforeEach(() => {
+    response = new Subject<HttpResponse<Blob>>();
+    steps = [];
+    service = {
+      generarPPTX: vi.fn(() => response.asObservable()),
+      confirmarGeneracion: vi.fn((): Observable<{ ok: boolean; generation_id: string }> => {
+        steps.push('confirmación');
+        return of({ ok: true, generation_id: generationId });
+      }),
+    };
+
+    // Prueba de la coordinación de descarga; no necesita renderizar la plantilla.
+    component = new Formulario(
+      new FormBuilder(),
+      service as unknown as FormularioService,
+      { setStyle: vi.fn() } as unknown as Renderer2,
+      { get: () => of({}) } as unknown as HttpClient,
+    );
+    component.modelos.at(0).patchValue({
+      modeloCertificado: 'INSTITUTO',
+      tipoModelo: 'DIPLOMADO',
+      nombres: 'Ana',
+      apellidos: 'Pérez',
+      temaDiplomado: 'Gestión pública',
+      fechaInicio: '2026-09-01',
+      fechaFin: '2026-09-24',
+      horasAcademicas: 100,
+      creditosAcademicos: 6,
+      folioNumero: 'ABC-123',
+      fechaEmision: '2026-09-24',
+      codigoEstudiante: '001',
+      ciudad: 'Trujillo',
+    }, { emitEvent: false });
+    expect(component.form.valid).toBe(true);
+
+    download = vi.fn(() => { steps.push('descarga'); });
+    vi.spyOn(
+      component as unknown as { descargarArchivo(blob: Blob, filename: string): void },
+      'descargarArchivo',
+    ).mockImplementation((blob, filename) => download(blob, filename));
+    vi.spyOn(window, 'alert').mockImplementation(() => {});
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    vi.spyOn(console, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    response.complete();
+    vi.restoreAllMocks();
+  });
+
+  const headers = () => new HttpHeaders({
+    'X-Generation-Id': generationId,
+    'Content-Disposition': 'attachment; filename="certificados.pptx"',
+  });
+
+  it('confirma una sola vez después de recibir el Blob e iniciar la descarga', () => {
+    component.onSubmit();
+    expect(service.confirmarGeneracion).not.toHaveBeenCalled();
+    expect(download).not.toHaveBeenCalled();
+
+    const blob = new Blob(['pptx']);
+    response.next(new HttpResponse({ body: blob, headers: headers() }));
+
+    expect(download).toHaveBeenCalledWith(blob, 'certificados.pptx');
+    expect(service.confirmarGeneracion).toHaveBeenCalledExactlyOnceWith(generationId);
+    expect(steps).toEqual(['descarga', 'confirmación']);
+    expect(service.generarPPTX).toHaveBeenCalledOnce();
+  });
+
+  it.each([null, new Blob([])])('no confirma una respuesta sin archivo válido', (body) => {
+    component.onSubmit();
+    response.next(new HttpResponse<Blob>({ body, headers: headers() }));
+
+    expect(download).not.toHaveBeenCalled();
+    expect(service.confirmarGeneracion).not.toHaveBeenCalled();
+    expect(window.alert).toHaveBeenCalledOnce();
+  });
+
+  it('conserva la descarga cuando el backend todavía no devuelve un ID', () => {
+    component.onSubmit();
+    response.next(new HttpResponse({ body: new Blob(['pptx']) }));
+
+    expect(download).toHaveBeenCalledOnce();
+    expect(service.confirmarGeneracion).not.toHaveBeenCalled();
+  });
+
+  it('no confirma ni descarga cuando falla la generación', () => {
+    component.onSubmit();
+    response.error(new Error('Generation failed'));
+
+    expect(download).not.toHaveBeenCalled();
+    expect(service.confirmarGeneracion).not.toHaveBeenCalled();
+    expect(window.alert).toHaveBeenCalledOnce();
+  });
+
+  it('un error de confirmación no vuelve a generar ni descargar el archivo', () => {
+    service.confirmarGeneracion.mockReturnValue(throwError(() => new Error('Offline')));
+    component.onSubmit();
+    response.next(new HttpResponse({ body: new Blob(['pptx']), headers: headers() }));
+
+    expect(download).toHaveBeenCalledOnce();
+    expect(service.generarPPTX).toHaveBeenCalledOnce();
+    expect(console.warn).toHaveBeenCalledOnce();
+    expect(window.alert).not.toHaveBeenCalled();
+  });
+});
