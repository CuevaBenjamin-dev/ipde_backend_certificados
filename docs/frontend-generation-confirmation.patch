@@ -0,0 +1,112 @@
+import { HttpErrorResponse, provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { FormularioService } from './formularioService';
+
+describe('FormularioService: confirmación de generación', () => {
+  const apiUrl = 'https://diplomas-back.onrender.com/api/diplomas';
+  const generationId = '0123456789abcdef0123456789abcdef';
+  const confirmationUrl = `${apiUrl}/confirmar/${generationId}`;
+  let service: FormularioService;
+  let http: HttpTestingController;
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      providers: [provideHttpClient(), provideHttpClientTesting()],
+    });
+    service = TestBed.inject(FormularioService);
+    http = TestBed.inject(HttpTestingController);
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    http.verify();
+    vi.useRealTimers();
+    TestBed.resetTestingModule();
+  });
+
+  it('envía el ID al endpoint correcto con tiempo máximo y cuerpo vacío', () => {
+    const next = vi.fn();
+    service.confirmarGeneracion(generationId).subscribe(next);
+
+    const request = http.expectOne(confirmationUrl);
+    expect(request.request.method).toBe('POST');
+    expect(request.request.body).toEqual({});
+    expect(request.request.timeout).toBe(10000);
+    request.flush({ ok: true, generation_id: generationId });
+
+    expect(next).toHaveBeenCalledWith({ ok: true, generation_id: generationId });
+    http.expectNone(apiUrl);
+  });
+
+  it.each([0, 408, 429, 500, 503])(
+    'reintenta errores temporales %s a los 1 y 2 segundos como máximo',
+    (status) => {
+      const error = vi.fn();
+      service.confirmarGeneracion(generationId).subscribe({ error });
+
+      const fail = () => {
+        const request = http.expectOne(confirmationUrl);
+        if (status === 0) {
+          request.error(new ProgressEvent('error'));
+        } else {
+          request.flush({}, { status, statusText: 'Temporary failure' });
+        }
+      };
+
+      fail();
+      vi.advanceTimersByTime(999);
+      http.expectNone(confirmationUrl);
+      vi.advanceTimersByTime(1);
+      fail();
+      vi.advanceTimersByTime(1999);
+      http.expectNone(confirmationUrl);
+      vi.advanceTimersByTime(1);
+      fail();
+
+      expect(error).toHaveBeenCalledTimes(1);
+      expect(error.mock.calls[0][0]).toBeInstanceOf(HttpErrorResponse);
+      vi.advanceTimersByTime(10000);
+      http.expectNone(confirmationUrl);
+      http.expectNone(apiUrl);
+    },
+  );
+
+  it.each([400, 401, 403, 404])('no reintenta errores permanentes %s', (status) => {
+    const error = vi.fn();
+    service.confirmarGeneracion(generationId).subscribe({ error });
+
+    http.expectOne(confirmationUrl).flush({}, { status, statusText: 'Rejected' });
+
+    expect(error).toHaveBeenCalledTimes(1);
+    vi.advanceTimersByTime(10000);
+    http.expectNone(confirmationUrl);
+  });
+
+  it('permite recuperar una confirmación y conserva el mismo ID', () => {
+    const next = vi.fn();
+    service.confirmarGeneracion(generationId).subscribe(next);
+
+    http.expectOne(confirmationUrl).flush({}, { status: 503, statusText: 'Unavailable' });
+    vi.advanceTimersByTime(1000);
+    http.expectOne(confirmationUrl).flush({ ok: true, generation_id: generationId });
+
+    expect(next).toHaveBeenCalledOnce();
+    http.expectNone(apiUrl);
+  });
+
+  it('no reintenta automáticamente la generación del PPTX', () => {
+    const error = vi.fn();
+    service.generarPPTX({ items: [] }).subscribe({ error });
+    const request = http.expectOne(apiUrl);
+    expect(request.request.responseType).toBe('blob');
+    request.error(new ProgressEvent('error'));
+
+    expect(error).toHaveBeenCalledOnce();
+    vi.advanceTimersByTime(10000);
+    http.expectNone(apiUrl);
+    http.expectNone(confirmationUrl);
+  });
+});
